# We really only want Intel Vulkan, but to satisfy some build checks we also
# build the DRI driver, GBM, EGL, and GLES2.  The last few are overridden
# at package install with the ANGLE/magma equivalents.
media-libs/mesa magma vulkan video_cards_intel X wayland gbm egl gles2 -gallium -gles1 -glx -llvm -video_cards_llvmpipe -video_cards_virgl
sys-apps/hwids -net -pci udev -usb
# Fails on tael because CMake doesn't cross compile vkcube
dev-util/vulkan-tools X cube
