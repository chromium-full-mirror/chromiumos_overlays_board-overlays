# We want: Intel Vulkan and software GLX, but to satisfy some ebuild checks we also
# build EGL and GLES2.  The last two are overridden at package install with ANGLE.
media-libs/mesa magma vulkan video_cards_intel video_cards_softpipe video_cards_virgl X wayland egl gles2 kvm_guest gallium glx gbm -classic -gles1 -llvm -video_cards_llvmpipe
