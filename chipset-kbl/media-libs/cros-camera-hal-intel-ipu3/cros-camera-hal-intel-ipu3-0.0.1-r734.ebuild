EAPI=5

CROS_WORKON_COMMIT=("4f9060441f02dfbecb35273171d65347375c6e68" "46bf49301ff418676313d63b34a95301cf13567c")
CROS_WORKON_TREE=("e7dba8c91c1f3257c34d4a7ffff0ea2537aeb6bb" "3dc4a52c74da4480e5dd22c14e92f8418b347340" "7ce5b67ae12f756c5a40a27ec2a037c88176c97a")
