EAPI=5

CROS_WORKON_COMMIT=("0bd029c40da2d687ee4e095902c130c49a2ab75c" "2b9d5c801a422e4c44ba53d68ce76c242f1339a1")
CROS_WORKON_TREE=("e7dba8c91c1f3257c34d4a7ffff0ea2537aeb6bb" "1f5bbd5363008347b153c2beb9a4be9a700eb090" "355c0e1ea1bd8bc659710e4002e1d3e84ea57ae4")
