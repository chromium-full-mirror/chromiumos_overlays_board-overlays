EAPI=5

CROS_WORKON_COMMIT=("e2213bedebcc1d90f50f5c117b65962cc7856188" "c57a441b3f1daecebb45c79fa6dd48091de2208a")
CROS_WORKON_TREE=("e7dba8c91c1f3257c34d4a7ffff0ea2537aeb6bb" "bd69f6a04d7c71798d29e1d4528d7ae9c9daa68f" "4a52ce9dd5972cf3baec2bec9865cf3517fc7084")
CROS_WORKON_PROJECT=("chromiumos/platform2" "chromiumos/platform/camera")
CROS_WORKON_LOCALNAME=("../platform2" "../platform/camera")
CROS_WORKON_DESTDIR=("${S}/platform2" "${S}/platform2/platform_camera")
CROS_WORKON_SUBTREE=(".gn common-mk" "hal/intel/ipu3")
