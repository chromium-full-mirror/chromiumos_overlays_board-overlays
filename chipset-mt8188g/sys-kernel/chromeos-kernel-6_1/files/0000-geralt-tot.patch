+/* YUV part driver */
+static void ut_yuv_set_ops(struct device *dev)
+{
+	struct mtk_ut_yuv_device *drvdata = dev_get_drvdata(dev);
+
+	drvdata->ops.reset = NULL;
+	drvdata->ops.s_stream = NULL;
+	drvdata->ops.apply_cq = NULL;
+	drvdata->ops.initialize = NULL;
+}
