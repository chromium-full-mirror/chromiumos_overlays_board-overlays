+				     debug_cmd, IMGADL_ADL_DMA_0_DEBUG);
+	pr_info("[adl_ipui_dma_even]mdle_cnt(0x%X), cmd_length(0x%X)\n",
+		debug_data & 0x0FFFF, (debug_data >> 16) & 0x0FFFF);
