+void imgsys_traw_debug_dump(struct mtk_imgsys_dev *imgsys_dev, unsigned int engine)
+{
+	void __iomem *traw_reg_ba = 0L;
+	unsigned int i;
+	unsigned int reg_map = REG_MAP_E_TRAW;
+
+	if (engine & IMGSYS_ENG_LTR) {
+		reg_map = REG_MAP_E_LTRAW;
+		g_reg_base_addr = TRAW_B_BASE_ADDR;
+		traw_reg_ba = g_ltraw_reg_ba;
+	} else if (engine & IMGSYS_ENG_XTR) {
+		reg_map = REG_MAP_E_XTRAW;
+		g_reg_base_addr = TRAW_C_BASE_ADDR;
+		traw_reg_ba = g_xtraw_reg_ba;
+	} else {
+		g_reg_base_addr = TRAW_A_BASE_ADDR;
+		traw_reg_ba = g_traw_reg_ba;
+	}
+
+	if (!traw_reg_ba) {
+		dev_info(imgsys_dev->dev, "%s Unable to ioremap regmap(%d)\n",
+			 __func__, reg_map);
+		dev_info(imgsys_dev->dev, "%s of_iomap fail, devnode(%s).\n",
+			 __func__, imgsys_dev->dev->of_node->name);
+		return;
+	}
+
+	/* DL debug data */
+	imgsys_traw_dump_dl(imgsys_dev, traw_reg_ba, TRAW_CTL_DBG_SEL, TRAW_CTL_DBG_PORT);
+
+	/* Ctrl registers */
+	for (i = 0x0; i <= TRAW_CTL_ADDR_OFST; i += 16) {
+		pr_info("[0x%08X] 0x%08X 0x%08X 0x%08X 0x%08X",
+			(unsigned int)(g_reg_base_addr + i),
+			(unsigned int)ioread32((void *)(traw_reg_ba + i)),
+			(unsigned int)ioread32((void *)(traw_reg_ba + i + 4)),
+			(unsigned int)ioread32((void *)(traw_reg_ba + i + 8)),
+			(unsigned int)ioread32((void *)(traw_reg_ba + i + 12)));
+	}
+	/* Dma registers */
+	for (i = TRAW_DMA_ADDR_OFST; i <= TRAW_DMA_ADDR_END; i += 16) {
+		pr_info("[0x%08X] 0x%08X 0x%08X 0x%08X 0x%08X",
+			(unsigned int)(g_reg_base_addr + i),
+			(unsigned int)ioread32((void *)(traw_reg_ba + i)),
+			(unsigned int)ioread32((void *)(traw_reg_ba + i + 4)),
+			(unsigned int)ioread32((void *)(traw_reg_ba + i + 8)),
+			(unsigned int)ioread32((void *)(traw_reg_ba + i + 12)));
+	}
+	/* Data registers */
+	for (i = TRAW_DATA_ADDR_OFST; i <= TRAW_MAX_ADDR_OFST; i += 16) {
+		pr_info("[0x%08X] 0x%08X 0x%08X 0x%08X 0x%08X",
+			(unsigned int)(g_reg_base_addr + i),
+			(unsigned int)ioread32((void *)(traw_reg_ba + i)),
+			(unsigned int)ioread32((void *)(traw_reg_ba + i + 4)),
+			(unsigned int)ioread32((void *)(traw_reg_ba + i + 8)),
+			(unsigned int)ioread32((void *)(traw_reg_ba + i + 12)));
+	}
+
+	/* DMA debug data */
+	imgsys_traw_dump_dma(imgsys_dev, traw_reg_ba, TRAW_DMA_DBG_SEL, TRAW_DMA_DBG_PORT);
+	/* CQ debug data */
+	imgsys_traw_dump_cq(imgsys_dev, traw_reg_ba, TRAW_CTL_DBG_SEL, TRAW_CTL_DBG_PORT);
+	/* DRZH2N debug data */
+	imgsys_traw_dump_drzh2n(imgsys_dev, traw_reg_ba, TRAW_CTL_DBG_SEL, TRAW_CTL_DBG_PORT);
+	/* SMTO debug data */
+	imgsys_traw_dump_smto(imgsys_dev, traw_reg_ba, TRAW_CTL_DBG_SEL, TRAW_CTL_DBG_PORT);
+}
+void imgsys_traw_ndd_dump(struct mtk_imgsys_dev *imgsys_dev,
+				struct imgsys_ndd_frm_dump_info *frm_dump_info)
+{
+	const char *traw_name;
+	char file_name[256] = "\0";
+	ssize_t ret;
+	uint32_t *cq_va = NULL;
+	uint64_t cq_ofst = 0;
+#if defined(IMGSYS_NDD_FROM_KERNEL)
+	struct file *cfile;
+	loff_t pos = 0;
+#endif
+	if ((frm_dump_info->eng_e > IMGSYS_NDD_ENG_XTR) || (frm_dump_info->eng_e < IMGSYS_NDD_ENG_TRAW)) {
+		dev_err(imgsys_dev->dev, "%s wrong ndd traw eng enum %d\n", __func__, frm_dump_info->eng_e);
+		return;
+	}
+
+	cq_ofst = frm_dump_info->cq_ofst[frm_dump_info->eng_e];
+
+	switch (frm_dump_info->eng_e) {
+	case IMGSYS_NDD_ENG_TRAW:
+		traw_name = frm_dump_info->user_buffer ? "REG_TRAW_traw.reg" : "REG_TRAW_traw.regKernel";
+		break;
+	case IMGSYS_NDD_ENG_LTR:
+		traw_name = frm_dump_info->user_buffer ? "REG_LTRAW_ltraw.reg" : "REG_LTRAW_ltraw.regKernel";
+		break;
+	case IMGSYS_NDD_ENG_XTR:
+		traw_name = frm_dump_info->user_buffer ? "REG_XTRAW_xtraw.reg" : "REG_XTRAW_xtraw.regKernel";
+		break;
+	default:
+		dev_err(imgsys_dev->dev, "%s invalid  ndd traw eng enum %d\n", __func__, frm_dump_info->eng_e);
+		return;
+	}
+
+	cq_va = (uint32_t *)((uint64_t)mtk_hcp_get_reserve_mem_virt(imgsys_dev->scp_pdev, TRAW_MEM_C_ID) + cq_ofst);
+	if (cq_va == NULL) {
+		dev_err(imgsys_dev->dev, "%s get null cq_va with ofst 0x%llx\n", __func__, cq_ofst);
+		return;
+	}
+
+	ret = snprintf(file_name, sizeof(file_name), "%s%s", frm_dump_info->fp, traw_name);
+	if ((ret < 0) || (ret >= sizeof(file_name))) {
+		dev_err(imgsys_dev->dev, "wrong traw ndd file name %s\n", file_name);
+		return;
+	}
+	dev_dbg(imgsys_dev->dev, "%s: traw ndd dump from 0x%llx to file %s +\n", __func__, (uint64_t)cq_va, file_name);
+
+	if (frm_dump_info->user_buffer) {
+		ret = copy_to_user(frm_dump_info->user_buffer,
+				(u8 *)file_name, FP_SIZE);
+		if (ret != 0) {
+			dev_err(imgsys_dev->dev, "%s failed to copy file name to user\n", __func__);
+			return;
+		}
+		frm_dump_info->user_buffer += FP_SIZE;
+
+		ret = copy_to_user(frm_dump_info->user_buffer,
+				(u8 *)cq_va, TRAW_REG_RANGE);
+		if (ret != 0) {
+			dev_err(imgsys_dev->dev, "%s failed to copy register data to user\n", __func__);
+			return;
+		}
+		frm_dump_info->user_buffer += TRAW_REG_RANGE;
+	} else {
+#if defined(IMGSYS_NDD_FROM_KERNEL)
+		cfile = filp_open(file_name, O_CREAT | O_RDWR, 0666);
+		if (IS_ERR(cfile)) {
+			dev_err(imgsys_dev->dev, "%s open file %s failed\n", __func__, file_name);
+			return;
+		}
+
+		ret = kernel_write(cfile, (void *)cq_va, TRAW_REG_RANGE, &pos);
+		if (ret < 0) {
+			dev_err(imgsys_dev->dev, "%s failed to write register data to file\n", __func__);
+			filp_close(cfile, NULL);
+			return;
+		}
+		filp_close(cfile, NULL);
+#endif
+	}
+
+	dev_dbg(imgsys_dev->dev, "%s: -\n", __func__);
+}
+EXPORT_SYMBOL(imgsys_traw_ndd_dump);
+
+void imgsys_traw_uninit(struct mtk_imgsys_dev *imgsys_dev)
+{
+	if (g_traw_reg_ba) {
+		iounmap(g_traw_reg_ba);
+		g_traw_reg_ba = 0L;
+	}
+	if (g_ltraw_reg_ba) {
+		iounmap(g_ltraw_reg_ba);
+		g_ltraw_reg_ba = 0L;
+	}
+	if (g_xtraw_reg_ba) {
+		iounmap(g_xtraw_reg_ba);
+		g_xtraw_reg_ba = 0L;
+	}
+}
