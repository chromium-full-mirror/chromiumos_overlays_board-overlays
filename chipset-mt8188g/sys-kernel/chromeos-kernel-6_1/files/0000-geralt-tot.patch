+	for (hw_idx = 0 ; hw_idx < PQDIP_HW_SET ; hw_idx++) {
+		for (i = 0 ; i < PQDIP_INIT_ARRAY_COUNT ; i++) {
+			ofset = gpqdip_reg_base[hw_idx]
