+	dev_info(dev, "[%s] ut_raw_trigger_rawi\n", __func__);
+
+	writel_relaxed(0x10, base + REG_CTL_RAWI_TRIG);
+	wmb(); /* TBC */
+
+	return 0;
+}
+#ifdef ISP7_1
+static int ut_raw_trigger_rawi_r5(struct device *dev, int on)
