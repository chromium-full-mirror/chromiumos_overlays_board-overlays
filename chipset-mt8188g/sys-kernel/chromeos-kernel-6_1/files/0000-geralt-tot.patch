+			 (0x15150000 + i + 0x4),
+			 ioread32((dip_reg_base + i + 0x4)),
+			 (0x15150000 + i + 0x8),
+			 ioread32((dip_reg_base + i + 0x8)),
+			 (0x15150000 + i + 0xc),
+			 ioread32((dip_reg_base + i + 0xc)));
+	}
+
+	dip_reg_base = gdip_reg_base[0]; // dip: 0x15100000
+
+	/* Set DIPCTL_DBG_SEL[3:0] to 0x1 */
+	/* Set DIPCTL_DBG_SEL[15:8] to 0x18 */
+	/* Set DIPCTL_DBG_SEL[19:6] to 0x1*/
+	dev_info(imgsys_dev->dev, "%s: dipctl_dbg_sel_tnc\n", __func__);
+	iowrite32(0x1801, (void *)(dip_reg_base + DIPCTL_DBG_SEL));
+	dev_info(imgsys_dev->dev, "%s: tnc_debug: %08X", __func__,
+		 ioread32((dip_reg_base + DIPCTL_DBG_OUT)));
+
+	/* Set DIPCTL_DBG_SEL[3:0] to 0x1 */
+	/* Set DIPCTL_DBG_SEL[15:8] to 0x0 */
+	/* Set DIPCTL_DBG_SEL[19:6] to 0x0~0xD */
+	dev_info(imgsys_dev->dev, "%s: dipctl_dbg_sel_nr3d\n", __func__);
+	iowrite32(0x13, (void *)(dip_reg_base + NR3D_DBG_SEL));
+	iowrite32(0x00001, (void *)(dip_reg_base + DIPCTL_DBG_SEL));
+	dev_info(imgsys_dev->dev, "%s: nr3d_sot_latch_32~1: %08X", __func__,
+		 ioread32((dip_reg_base + DIPCTL_DBG_OUT)));
+	iowrite32(0x20001, (void *)(dip_reg_base + DIPCTL_DBG_SEL));
+	dev_info(imgsys_dev->dev, "%s: nr3d_eot_latch_32~1: %08X", __func__,
+		 ioread32((dip_reg_base + DIPCTL_DBG_OUT)));
+	iowrite32(0x10001, (void *)(dip_reg_base + DIPCTL_DBG_SEL));
+	dev_info(imgsys_dev->dev, "%s: nr3d_sot_latch_33~39: %08X", __func__,
+		 ioread32((dip_reg_base + DIPCTL_DBG_OUT)));
+	iowrite32(0x30001, (void *)(dip_reg_base + DIPCTL_DBG_SEL));
+	dev_info(imgsys_dev->dev, "%s: nr3d_eot_latch_33~39: %08X", __func__,
+		 ioread32((dip_reg_base + DIPCTL_DBG_OUT)));
+	iowrite32(0x40001, (void *)(dip_reg_base + DIPCTL_DBG_SEL));
+	dev_info(imgsys_dev->dev, "%s: nr3d_tif4~1: %08X", __func__,
+		 ioread32((dip_reg_base + DIPCTL_DBG_OUT)));
+	iowrite32(0x50001, (void *)(dip_reg_base + DIPCTL_DBG_SEL));
+	dev_info(imgsys_dev->dev, "%s: nr3d_tif8~5: %08X", __func__,
+		 ioread32((dip_reg_base + DIPCTL_DBG_OUT)));
+	iowrite32(0x60001, (void *)(dip_reg_base + DIPCTL_DBG_SEL));
+	dev_info(imgsys_dev->dev, "%s: nr3d_tif12~9: %08X", __func__,
+		 ioread32((dip_reg_base + DIPCTL_DBG_OUT)));
+	iowrite32(0x70001, (void *)(dip_reg_base + DIPCTL_DBG_SEL));
+	dev_info(imgsys_dev->dev, "%s: nr3d_tif16~13: %08X", __func__,
+		 ioread32((dip_reg_base + DIPCTL_DBG_OUT)));
+	iowrite32(0x80001, (void *)(dip_reg_base + DIPCTL_DBG_SEL));
+	dev_info(imgsys_dev->dev, "%s: nr3d_tif20~17: %08X", __func__,
+		 ioread32((dip_reg_base + DIPCTL_DBG_OUT)));
+	iowrite32(0x90001, (void *)(dip_reg_base + DIPCTL_DBG_SEL));
+	dev_info(imgsys_dev->dev, "%s: nr3d_tif24~21: %08X", __func__,
+		 ioread32((dip_reg_base + DIPCTL_DBG_OUT)));
+	iowrite32(0xA0001, (void *)(dip_reg_base + DIPCTL_DBG_SEL));
+	dev_info(imgsys_dev->dev, "%s: nr3d_tif28~25: %08X", __func__,
+		 ioread32((dip_reg_base + DIPCTL_DBG_OUT)));
+	iowrite32(0xB0001, (void *)(dip_reg_base + DIPCTL_DBG_SEL));
+	dev_info(imgsys_dev->dev, "%s: nr3d_tif32~29: %08X", __func__,
+		 ioread32((dip_reg_base + DIPCTL_DBG_OUT)));
+	iowrite32(0xC0001, (void *)(dip_reg_base + DIPCTL_DBG_SEL));
+	dev_info(imgsys_dev->dev, "%s: nr3d_tif36~33: %08X", __func__,
+		 ioread32((dip_reg_base + DIPCTL_DBG_OUT)));
+	iowrite32(0xD0001, (void *)(dip_reg_base + DIPCTL_DBG_SEL));
+	dev_info(imgsys_dev->dev, "%s: nr3d_tif39~37: %08X", __func__,
+		 ioread32((dip_reg_base + DIPCTL_DBG_OUT)));
+}
+EXPORT_SYMBOL(imgsys_dip_debug_dump);
+
+void imgsys_dip_ndd_dump(struct mtk_imgsys_dev *imgsys_dev,
+				struct imgsys_ndd_frm_dump_info *frm_dump_info)
+{
+	char *dip_name;
+	char file_name[256] = "\0";
+	ssize_t ret;
+	uint32_t *cq_va = NULL;
+#if defined(IMGSYS_NDD_FROM_KERNEL)
+	struct file *cfile;
+	loff_t pos = 0;
+#endif
+	if ((frm_dump_info->eng_e != IMGSYS_NDD_ENG_DIP)) {
+		dev_err(imgsys_dev->dev, "%s wrong ndd dip eng enum %d\n", __func__, frm_dump_info->eng_e);
+		return;
+	}
+
+	cq_va = (uint32_t *)((uint64_t)mtk_hcp_get_reserve_mem_virt(imgsys_dev->scp_pdev, DIP_MEM_C_ID) + frm_dump_info->cq_ofst[frm_dump_info->eng_e]);
+	if (cq_va == NULL) {
+		dev_err(imgsys_dev->dev, "%s get null dip cq_va with ofst 0x%llx\n", __func__, frm_dump_info->cq_ofst[frm_dump_info->eng_e]);
+		return;
+	}
+
+	dip_name = frm_dump_info->user_buffer ? "REG_DIP_dip.reg" : "REG_DIP_dip.regKernel";
+	ret = snprintf(file_name, sizeof(file_name), "%s%s", frm_dump_info->fp, dip_name);
+	if ((ret < 0) || (ret >= sizeof(file_name))) {
+		dev_err(imgsys_dev->dev, "wrong dip ndd file name %s\n", file_name);
+		return;
+	}
+
+	dev_dbg(imgsys_dev->dev, "%s: dip ndd dump from 0x%llx to file %s +\n", __func__, (uint64_t)cq_va, file_name);
+
+	if (frm_dump_info->user_buffer) {
+		ret = copy_to_user(frm_dump_info->user_buffer, (u8 *)file_name, FP_SIZE);
+		if (ret != 0) {
+			dev_err(imgsys_dev->dev, "%s failed to copy file name to user\n", __func__);
+			return;
+		}
+		frm_dump_info->user_buffer += FP_SIZE;
+
+		ret = copy_to_user(frm_dump_info->user_buffer, (u8 *)cq_va, 0x9000);
+		if (ret != 0) {
+			dev_err(imgsys_dev->dev, "%s failed to copy register data to user\n", __func__);
+			return;
+		}
+		frm_dump_info->user_buffer += (0x48000 + 0x9000);
+
+		ret = copy_to_user(frm_dump_info->user_buffer, (u8 *)(cq_va + (0x9000 / 4)), DIP_REG_RANGE - 0x9000);
+		if (ret != 0) {
+			dev_err(imgsys_dev->dev, "%s failed to copy register data to user\n", __func__);
+			return;
+		}
+		frm_dump_info->user_buffer += (DIP_REG_RANGE - 0x9000);
+	} else {
+#if defined(IMGSYS_NDD_FROM_KERNEL)
+		cfile = filp_open(file_name, O_CREAT | O_RDWR, 0666);
+		if (IS_ERR(cfile)) {
+			dev_err(imgsys_dev->dev, "%s open file %s failed\n", __func__, file_name);
+			return;
+		}
+
+		ret = kernel_write(cfile, (void *)cq_va, 0x9000, &pos);
+		if (ret < 0) {
+			dev_err(imgsys_dev->dev, "%s failed to write register data to file\n", __func__);
+			filp_close(cfile, NULL);
+			return;
+		}
+		pos += 0x48000; // DIP REG OFFSET
+
+		ret = kernel_write(cfile, (void *)(cq_va + (0x9000 / 4)), DIP_REG_RANGE - 0x9000, &pos);
+		if (ret < 0) {
+			dev_err(imgsys_dev->dev, "%s failed to write register data to file\n", __func__);
+			filp_close(cfile, NULL);
+			return;
+		}
+		filp_close(cfile, NULL);
+#endif
+	}
+		dev_dbg(imgsys_dev->dev, "%s: -\n", __func__);
+}
+EXPORT_SYMBOL(imgsys_dip_ndd_dump);
+
+void imgsys_dip_uninit(struct mtk_imgsys_dev *imgsys_dev)
+{
+	unsigned int i;
+
+	for (i = 0; i < DIP_HW_SET; i++) {
+		iounmap(gdip_reg_base[i]);
+		gdip_reg_base[i] = 0L;
+	}
+}
+EXPORT_SYMBOL(imgsys_dip_uninit);
