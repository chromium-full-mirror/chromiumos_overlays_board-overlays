+				__func__,
+				idx,
+				fd->qos_info->qos_path[idx].path,
+				fd->qos_info->qos_path[idx].bw
+			);
+			fd->qos_info->qos_path[idx].bw = 0;
+			mtk_icc_set_bw(fd->qos_info->qos_path[idx].path, 0, 0);
+		}
+		kfree(fd->qos_info);
+	}
+}
