+static void mtk_aie_mmqos_uninit(struct mtk_aie_dev *fd)
+{
+	int idx = 0;
+
+	if (fd->qos_info) {
+		for (idx = 0; idx < AIE_QOS_MAX; idx++) {
+			if (!fd->qos_info->qos_path[idx].path) {
+				dev_dbg(fd->qos_info->dev,
