+static int mtk_imgsys_vidioc_qbuf(struct file *file, void *priv,
+				  struct v4l2_buffer *buf)
+{
+	struct mtk_imgsys_pipe *pipe = video_drvdata(file);
+	struct mtk_imgsys_video_device *node = mtk_imgsys_file_to_node(file);
+	struct vb2_buffer *vb = node->dev_q.vbq.bufs[buf->index];
+	struct mtk_imgsys_dev_buffer *dev_buf =
+					mtk_imgsys_vb2_buf_to_dev_buf(vb);
+	int plane;
+
+	if (buf->index >= VB2_MAX_FRAME || buf->index < 0) {
+		dev_info(pipe->imgsys_dev->dev, "[%s] error vb2 index %d\n", __func__, buf->index);
+		return -EINVAL;
+	}
+
+	vb = node->dev_q.vbq.bufs[buf->index];
+	dev_buf = mtk_imgsys_vb2_buf_to_dev_buf(vb);
+
+	if (!dev_buf)
+		return -EFAULT;
+
+	dev_buf->fmt = node->vdev_fmt;
+	dev_buf->rotation = node->rotation;
+	dev_buf->crop.c = node->crop;
+	dev_buf->compose = node->compose;
+	dev_buf->hflip = node->hflip;
+	dev_buf->vflip = node->vflip;
+	dev_buf->resize_ratio = node->resize_ratio;
+
+	/*
+	 * Let's hack vb2 buffer for now get around all the
+	 * buffer size/planes checks.
+	 *
+	 * TODO: Use create_bufs ioctl in the user space to
+	 * create buffers with different sizes.
+	 */
+	vb->num_planes = max_t(unsigned int, 1, dev_buf->fmt.fmt.pix_mp.num_planes);
+	for (plane = 0; plane < dev_buf->fmt.fmt.pix_mp.num_planes; ++plane) {
+		vb->planes[plane].length = dev_buf->fmt.fmt.pix_mp.plane_fmt[plane].sizeimage;
+		vb->planes[plane].min_length = dev_buf->fmt.fmt.pix_mp.plane_fmt[plane].sizeimage;
+	}
+
+	return vb2_qbuf(node->vdev.queue, &pipe->imgsys_dev->mdev, buf);
+}
