+#define HIMAX_SPI_FUNCTION_READ				0xf3
+#define HIMAX_SPI_FUNCTION_WRITE			0xf2
+/* HIDRAW commands */
+#define HIMAX_HID_FW_UPDATE_BL_CMD			0x77
+#define HIMAX_HID_FW_UPDATE_MAIN_CMD			0x55
