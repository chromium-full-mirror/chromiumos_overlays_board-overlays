+			dev_err(cbas_ec.dev, "cannot find parent bus\n");
+			ret = -ENODEV;
+			goto out;
+		}
+
+		cbas_ec.tp_i2c_client =
+			i2c_new_client_device(tp_bus, cbas_ec.tp_info);
