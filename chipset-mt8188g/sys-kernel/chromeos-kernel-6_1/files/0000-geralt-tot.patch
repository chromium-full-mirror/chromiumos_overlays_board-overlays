+#define	HIMAX_PWD_OPEN_START				0x7777
+#define	HIMAX_PWD_OPEN_END				0x8888
+#define	HIMAX_PWD_SHORT_START				0x1111
+#define	HIMAX_PWD_SHORT_END				0x3333
