CHROMEOS_KERNEL_SPLITCONFIG="chromiumos-qualcomm"
CHROMEOS_KERNEL_ARCH="arm64"

BOARD_COMPILER_FLAGS="-march=armv8-a+crc -mfpu=crypto-neon-fp-armv8 -mfloat-abi=hard"

# Initial value just for style purposes.
USE=""

USE="${USE} big_little"
USE="${USE} device_tree"
USE="${USE} drm_atomic"
USE="${USE} hardfp"
USE="${USE} kernel-5_4"
USE="${USE} native_gpu_memory_buffers"
USE="${USE} neon"
USE="${USE} qc7180"

# Enable HW codecs using V4L2 API.
USE="${USE} v4l2_codec"

# Enable vulkan, but only for cros (see package.use)
USE="${USE} vulkan"

# Enable CPU zero-copy for Chrome camera stack.
USE="${USE} video_capture_use_gpu_memory_buffer"
