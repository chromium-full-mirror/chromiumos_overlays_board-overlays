+	const char *name;
+	int pg;
+	const char *pn;
+};
+
+struct regname {
+	struct regbase *base;
+	int id;
+	u32 ofs;
+	const char *name;
+};
+
+struct clkchk_ops {
+	const struct regname *(*get_all_regnames)(void);
+	u32 *(*get_spm_pwr_status_array)(void);
