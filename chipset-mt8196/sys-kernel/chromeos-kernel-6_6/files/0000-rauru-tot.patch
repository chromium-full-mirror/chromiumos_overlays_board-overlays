+	mtk_dpi_mask_v2(dpi, DPI_YUV, DPI_YUV_EN, DPI_YUV_EN);
+	mtk_dpi_mask_v2(dpi, DPI_YUV, DPI_YUV422_EN, DPI_YUV422_EN);
