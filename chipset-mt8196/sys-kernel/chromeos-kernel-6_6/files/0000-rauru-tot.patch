+bool clkchk_pvdck_is_enabled(struct provider_clk *pvdck)
+{
+	struct clk_hw *hw;
+
+	if (!pvdck)
+		return false;
+
+	if (!clkchk_pvdck_is_on(pvdck))
+		return false;
+
+	hw = __clk_get_hw(pvdck->ck);
+
+	if (IS_ERR_OR_NULL(hw))
+		return false;
