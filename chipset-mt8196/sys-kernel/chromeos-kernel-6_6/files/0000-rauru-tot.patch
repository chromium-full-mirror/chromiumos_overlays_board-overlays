+static const char *ccf_state(struct provider_clk *pvdck)
+{
+	if (clkchk_pvdck_is_enabled(pvdck))
+		return "enabled";
+
+	if (clkchk_pvdck_is_prepared(pvdck))
+		return "prepared";
+
+	return "disabled";
+}
