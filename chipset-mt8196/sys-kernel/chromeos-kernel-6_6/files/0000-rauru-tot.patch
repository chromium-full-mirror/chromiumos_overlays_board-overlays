+static void mtk_dp_bridge_detach(struct drm_bridge *bridge)
+{
+	struct mtk_dp *mtk_dp = mtk_dp_from_bridge_v2(bridge);
+
+	if (mtk_dp->data->mst_support)
+		mtk_dp_mst_drv_deinit(mtk_dp);
+}
