+	if (ign == NULL)
+		return;
+
+	name = strsep(&c, " ");
+
+	fclk = get_all_fmeter_clks();
+
+	if (fclk == NULL || proc == NULL || name == NULL)
+		return;
+
+	pr_notice("fmeter name: %s\n", name);
+
+	fmeter_data = prepare_fmeter();
+
+	for (; fclk->type != FT_NULL; fclk++) {
+		u32 freq;
+
+		if (!strcmp(fclk->name, name)) {
+			freq = fmeter_freq(fclk);
+			proc(fclk, freq, data);
