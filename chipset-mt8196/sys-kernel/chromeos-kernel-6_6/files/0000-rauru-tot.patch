+#endif
+	dump_hwv_history(mm_hwv_regmap, 0);
+	dump_bus_reg(mm_hwv_regmap, 0);
+	dump_pll_reg(false);
+	check_hwv_irq_sta();
+	check_mm_hwv_irq_sta();
+	external_dump();
+	clkchk_bug_on_flag = true;
+}
