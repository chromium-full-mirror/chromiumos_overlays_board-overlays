+
+
+#define LPM_CONSTRAINT_GENERIC_OP(op, _priv) ({\
+	op.fs_read = lpm_generic_rc_read;\
+	op.fs_write = lpm_generic_rc_write;\
+	op.priv = _priv; })
+
+
+#define LPM_GENERIC_RC_NODE_INIT(_n, _name, _id, _type) ({\
