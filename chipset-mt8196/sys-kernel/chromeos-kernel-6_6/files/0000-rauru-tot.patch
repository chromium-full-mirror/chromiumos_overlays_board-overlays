+static int lpm_rc_entry_add(struct LPM_RC_ENTERY *n,
+					int mode, struct LPM_RC_ENTERY *p)
+{
+	return mtk_lpm_sysfs_sub_entry_add(n->name, mode,
+					   &p->handle, &n->handle);
+}
