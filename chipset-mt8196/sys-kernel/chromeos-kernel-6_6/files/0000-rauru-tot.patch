+	bool spm_stamp_en;
+	bool ceiling_support;
+	bool qos_mm_mode_en;
+};
+
+struct mtk_dvfsrc {
+	struct device *dev;
+/* opp */
+	int opp_type;
+	int fw_type;
+	struct dvfsrc_opp_desc *opp_desc;
+	u32 *vopp_uv_tlb;
+	u32 *dopp_kbps_tlb;
+	u32 *eopp_mbps_tlb;
+/* debug */
+	void __iomem *regs;
