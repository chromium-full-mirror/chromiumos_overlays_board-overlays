@@ -0,0 +1,33 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Copyright (c) 2019 MediaTek Inc.
+ */
+
+#ifndef __LPM_DBG_FS_COMMON_H__
+#define __LPM_DBG_FS_COMMON_H__
+
+int lpm_trace_fs_init(void);
+int lpm_trace_fs_deinit(void);
