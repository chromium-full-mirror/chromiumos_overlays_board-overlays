+	/* get HW CG check status */
+	help->wakesrc->cg_check_sta =
+	(((plat_mmio_read(SPM_REQ_STA_4) >> SPM_HW_CG_CHECK_SHIFT_0) & SPM_HW_CG_CHECK_MASK_0) |
+	(plat_mmio_read(SPM_REQ_STA_5) & SPM_HW_CG_CHECK_MASK_1));
