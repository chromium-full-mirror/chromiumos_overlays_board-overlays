+{
+	set_clkdbg_ops(&clkdbg_mt8196_ops);
+
+	return 0;
+}
+
+static struct platform_driver clk_dbg_mt8196_drv = {
+	.probe = clk_dbg_mt8196_probe,
+	.driver = {
+		.name = "clk-dbg-mt8196",
+		.owner = THIS_MODULE,
+	},
+};
+
+/*
+ * init functions
+ */
+
+static int __init clkdbg_mt8196_init(void)
+{
+	return clk_dbg_driver_register(&clk_dbg_mt8196_drv, "clk-dbg-mt8196");
+}
+
+static void __exit clkdbg_mt8196_exit(void)
+{
+	unset_clkdbg_ops();
+	stop_clkdbg_test_task();
+	platform_driver_unregister(&clk_dbg_mt8196_drv);
+}
+
+subsys_initcall(clkdbg_mt8196_init);
+module_exit(clkdbg_mt8196_exit);
