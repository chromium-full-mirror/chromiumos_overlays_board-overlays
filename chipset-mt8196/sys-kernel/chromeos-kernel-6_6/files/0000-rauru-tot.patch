+static int lpm_get_wakeup_status(void)
+{
+	struct lpm_log_helper *help = &log_help;
+
+	if (!help->wakesrc || !lpm_spm_base)
+		return -EINVAL;
+
+	help->wakesrc->r12 = plat_mmio_read(SPM_BK_WAKE_EVENT);
+	help->wakesrc->r12_ext = plat_mmio_read(SPM_WAKEUP_STA);
