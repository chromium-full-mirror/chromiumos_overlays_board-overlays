+				    rc_id, LPM_RC_NODE_VALID_BBLPM);
+		lpm_rc_node_add(&valid->hBblpm, 0200, &valid->root);
+		LPM_GENERIC_RC_NODE_INIT(valid->hTrace, "trace",
+				    rc_id, LPM_RC_NODE_VALID_TRACE);
+		lpm_rc_node_add(&valid->hTrace, 0200, &valid->root);
