+{
+	u32 irq_sta;
+
+	irq_sta = get_mt8196_reg_value(hwv, HWV_IRQ_STATUS);
+
+	if ((irq_sta & HWV_INT_CG_TRIGGER) == HWV_INT_CG_TRIGGER) {
+		dump_hwv_history(NULL, 0);
+		dump_bus_reg(NULL, 0);
+	}
+	if ((irq_sta & HWV_INT_PLL_TRIGGER) == HWV_INT_PLL_TRIGGER)
+		dump_pll_reg(true);
+}
