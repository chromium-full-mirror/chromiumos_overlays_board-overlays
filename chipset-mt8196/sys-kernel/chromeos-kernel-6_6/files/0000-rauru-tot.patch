index 0000000000000000000000000000000000000000..e3c692a29e1c4e45355633a004697afe579f42f7
--- /dev/null
+++ b/arch/arm64/boot/dts/mediatek/mt8196-rauru-hylia.dtsi
@@ -0,0 +1,663 @@
+// SPDX-License-Identifier: (GPL-2.0 OR MIT)
+/*
+ * Copyright 2024 Google LLC
+ */
+
+/dts-v1/;
+#include "mt8196-rauru.dtsi"
+
+/ {
+	pp3300_edp_x: regulator-pp3300-edp-x {
+		compatible = "regulator-fixed";
+		regulator-name = "pp3300_edp_x";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		enable-active-high;
+		gpio = <&pio 172 GPIO_ACTIVE_HIGH>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&edp_pp3300_pins>;
+		vin-supply = <&pp3300_z1>;
+	};
+
+	pp1000_dpbrdg: regulator-pp1000-dpbrdg {
+		compatible = "regulator-fixed";
+		regulator-name = "pp1000_dpbrdg";
+		pinctrl-names = "default";
+		pinctrl-0 = <&en_pp1000_dpbrdg>;
+		enable-active-high;
+		regulator-boot-on;
+		gpio = <&pio 82 GPIO_ACTIVE_HIGH>;
+		vin-supply = <&pp3300_z1>;
+	};
+
+	pp1800_dpbrdg: regulator-pp1800-dpbrdg-dx {
+		compatible = "regulator-fixed";
+		regulator-name = "pp1800_dpbrdg_dx";
+		pinctrl-names = "default";
+		pinctrl-0 = <&en_pp1800_dpbrdg>;
+		enable-active-high;
+		regulator-boot-on;
+		gpio = <&pio 84 GPIO_ACTIVE_HIGH>;
+		vin-supply = <&pp1800_vio18_s3>;
+	};
+
+	pp3300_dpbrdg: regulator-pp3300-dp-dx {
+		compatible = "regulator-fixed";
+		regulator-name = "pp3300_dpbrdg";
+		pinctrl-names = "default";
+		pinctrl-0 = <&en_pp3300_dpbrdg>;
+		enable-active-high;
+		regulator-boot-on;
+		gpio = <&pio 83 GPIO_ACTIVE_HIGH>;
+		vin-supply = <&pp3300_z1>;
+	};
+
+	pp1800_tchscr_report_disable: regulator-pp1800-tchscr-report-disable {
+		compatible = "regulator-fixed";
+		regulator-name = "pp1800_tchscr_report_disable";
+		pinctrl-names = "default";
+		enable-active-low;
+		regulator-boot-on;
+		pinctrl-0 = <&touch_pin_report>;
+		gpio = <&pio 30 GPIO_ACTIVE_LOW>;
+	};
+};
+
+&ap_i2c_ec_hid_kb {
+	status = "disabled";
+};
+
+&cros_ec_fp {
+	spi-cs-setup-delay-ns = <43>;
+	spi-cs-hold-delay-ns = <43>;
+};
+
+&i2c3 {
+	rt5650: rt5650@1a {
+		compatible = "realtek,rt5650";
+		reg = <0x1a>;
+		avdd-supply = <&pp1800_vio18_s3>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&en_codec_pwr_soc>;
+		cbj-sleeve-gpio = <&pio 174 GPIO_ACTIVE_HIGH>;
+		interrupts-extended = <&pio 10 IRQ_TYPE_EDGE_BOTH>;
+		#sound-dai-cells = <0>;
+		realtek,dmic1-data-pin = <2>;
+		realtek,jd-mode = <2>;
+		status = "okay";
+	};
+};
+
+&i2c3_pins {
+	pins-bus {
+		pinmux = <PINMUX_GPIO124__FUNC_SDA3>,
+				<PINMUX_GPIO123__FUNC_SCL3>;
+
+		/delete-property/ bias-pull-up;
+		bias-disable;
+		drive-strength = <MTK_DRIVE_4mA>;
+	};
+};
+
+&i2c4 {
+	anx_bridge: anx7625@58 {
+		compatible = "analogix,anx7625";
+		reg = <0x58>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&anx7625_pins>;
+		enable-gpios = <&pio 81 GPIO_ACTIVE_HIGH>;
+		reset-gpios = <&pio 86 GPIO_ACTIVE_HIGH>;
+		interrupts-extended = <&pio 14 IRQ_TYPE_LEVEL_LOW>;
+		vdd10-supply = <&pp1000_dpbrdg>;
+		vdd18-supply = <&pp1800_dpbrdg>;
+		vdd33-supply = <&pp3300_dpbrdg>;
+		analogix,audio-enable;
+		#address-cells = <1>;
+		#size-cells = <0>;
+		#sound-dai-cells = <0>;
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			port@0 {
+				reg = <0>;
+				anx7625_dp_in: endpoint {
+					remote-endpoint = <&dsi_out>;
+				};
+			};
+		};
+
+		switches {
+			#address-cells = <1>;
+			#size-cells = <0>;
+			switch@0 {
+				compatible = "typec-switch";
+				reg = <0>;
+				mode-switch;
+
+				ports {
+					#address-cells = <1>;
+					#size-cells = <0>;
+					port@0 {
+						reg = <0>;
+						anx_typec1: endpoint {
+							remote-endpoint = <&typec_port1>;
+						};
+					};
+				};
+			};
+		};
+	};
+};
+
+&dsi0 {
+	status = "okay";
+
+	port {
+		dsi_out: endpoint {
+			remote-endpoint = <&anx7625_dp_in>;
+		};
+	};
+};
+
+&usb_c1 {
+	ports {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		port@1 {
+			reg = <1>;
+
+			typec_port1: endpoint {
+				remote-endpoint = <&anx_typec1>;
+			};
+		};
+	};
+};
+
+&touchscreen {
+	vccio-supply = <&pp1800_tchscr_report_disable>;
+};
+
+&therm_intf{
+	mediatek,init-ttj-cpu = <105000>;
+	mediatek,init-ttj-gpu = <105000>;
+	mediatek,init-ttj-npu = <105000>;
+};
+
+&ap_i2c_tchpad {
+	pinctrl-0 = <&i2c0_pins &tchpad_int_odl>;
+	pinctrl-names = "default";
+	/delete-node/ trackpad@15;
+
+	/* synaptics touchpad */
+	trackpad@2c {
+		compatible = "hid-over-i2c";
+		reg = <0x2c>;
+		interrupts-extended = <&pio 8 IRQ_TYPE_LEVEL_LOW>;
+		hid-descr-addr = <0x0020>;
+		vcc-supply = <&pp3300_tchpad>;
+		wakeup-source;
+	};
+
+	/* carewe touchpad */
+	trackpad@68 {
+		compatible = "hid-over-i2c";
+		reg = <0x68>;
+		interrupts-extended = <&pio 8 IRQ_TYPE_LEVEL_LOW>;
+		hid-descr-addr = <0x0020>;
+		vcc-supply = <&pp3300_tchpad>;
+		post-power-on-delay-ms = <50>;
+		wakeup-source;
+	};
+};
+
+&panel {
+	power-supply = <&pp3300_edp_x>;
+};
+
+&sound {
+	compatible = "mediatek,mt8196-rt5650-sound";
+	model = "mt8196_rt5650";
+	mediatek,adsp = <&adsp>;
+	mediatek,dai-link = "AFE_SOF_DL_24CH", "AFE_SOF_DL1", "AFE_SOF_UL0",
+            "AFE_SOF_UL1", "AFE_SOF_UL2", "HDMI_FE", "DL2_FE", "Capture_9",
+            "I2SIN6_BE", "I2SOUT4_BE", "I2SOUT6_BE", "AP_DMIC_BE", "AP_DMIC_CH34_BE",
+            "TDM_DPTX_BE", "I2SOUT3_BE", "AP_DMIC_MULTICH_BE";
+
+	status = "okay";
+
+	dai-link-0 {
+		link-name = "I2SOUT6_BE";
+		mediatek,clk-provider = "cpu";
+		codec {
+			sound-dai = <&rt5650>;
+		};
+	};
+
+	dai-link-1 {
+		link-name = "I2SIN6_BE";
+		mediatek,clk-provider = "cpu";
+		codec {
+			sound-dai = <&rt5650>;
+		};
+	};
+
+	dai-link-2 {
+		link-name = "TDM_DPTX_BE";
+		codec {
+			sound-dai = <&dp_tx>;
+		};
+	};
+
+	dai-link-3 {
+		link-name = "I2SOUT3_BE";
+		mediatek,clk-provider = "cpu";
+		codec {
+			sound-dai = <&anx_bridge>;
+		};
+	};
+};
+
+&afe {
+	/* Only for ETDM in/out 4 */
+	etdm-out-ch = <2>;
+	etdm-in-ch = <2>;
+	etdm-out-sync = <0>; /* 0: disable; 1: enable */
+	etdm-in-sync = <0>; /* 0: disable; 1: enable */
+	etdm-ip-mode = <0>; /* 0: One IP multi-channel 1: Multi-IP 2-channel */
+	status = "okay";
+};
+
+&keyboard_controller {
+	keypad,num-columns = <18>;
+
+	function-row-physmap = <
+		MATRIX_KEY(0x00, 0x02, 0)		/* T1 */
+		MATRIX_KEY(0x03, 0x02, 0)		/* T2 */
+		MATRIX_KEY(0x02, 0x02, 0)		/* T3 */
+		MATRIX_KEY(0x01, 0x02, 0)		/* T4 */
+		MATRIX_KEY(0x04, 0x04, 0)		/* T5 */
+		MATRIX_KEY(0x02, 0x04, 0)		/* T6 */
+		MATRIX_KEY(0x01, 0x04, 0)		/* T7 */
+		MATRIX_KEY(0x02, 0x0b, 0)		/* T8 */
+		MATRIX_KEY(0x01, 0x09, 0)		/* T9 */
+		MATRIX_KEY(0x00, 0x04, 0)		/* T10 */
+		MATRIX_KEY(0x00, 0x01, 0)		/* T11 */
+		MATRIX_KEY(0x01, 0x05, 0)		/* T12 */
+		MATRIX_KEY(0x03, 0x05, 0)		/* T13 */
+		MATRIX_KEY(0x00, 0x0b, 0)		/* T14 */
+	>;
+};
+
+&mmc1 {
+	status = "disabled";
+};
+
+&mt6363_vbuck6 {
+	status = "disabled";
+};
+
+&mt6363_vbuck7 {
+	status = "disabled";
+};
+
+&mt6363_vsram_mdfe {
+	regulator-always-on;
+};
+
+&pcie1 {
+	status = "disabled";
+};
+
+&pciephy1 {
+	status = "disabled";
+};
+
+&backlight {
+	post-pwm-on-delay-ms = <10>;
+};
+
+&pio {
+	/* 271 lines */
+	gpio-line-names =
+		"STRAP_EINT0",			/* 0 */
+		"EC_AP_C1_HPD_OD_R",
+		"STRAP_EINT2",
+		/*
+		 * AP_FLASH_WP_L is crossystem ABI. Schematics
+		 * call it AP_WP_ODL.
+		 */
+		"AP_FLASH_WP_L",
+		"HPD_INT_AP_L",
+		"LID_ACCEL_INT_SCP_L",
+		"IMU_INT_SCP_L",
+		"TCHSCR_INT_1V8_ODL",
+		"TCHPAD_INT_ODL",
+		"",
+		"HP_INT_ODL",			/* 10 */
+		"SD_CD_AP_ODL",
+		"FP_AP_INT_1V8_S3_ODL",
+		"EDP_HPD_1V8",
+		"DPBRDG_INT_ODL",
+		"",
+		"STRAP_EINT16",
+		"STRAP_EINT17",
+		"GSC_AP_INT_ODL",
+		"EC_AP_INT_ODL",
+		"",		/* 20 */
+		"",
+		"",
+		"DMIC1_CLK",
+		"DMIC1_DATA",
+		"",
+		"FP_RST_1V8_S3_L",
+		"AP_FP_FW_UP_STRAP",
+		"AP_XHCI_INIT_DONE",
+		"AP_EC_WARM_RST_REQ",
+		"TCHSCR_REPORT_DISABLE",	/* 30 */
+		"TCHSCR_RST_1V8_L",
+		"EC_AP_DP_HPD_OD",
+		"IO_JTAG_TRST_L",
+		"IO_JTAG_TDI",
+		"IO_JTAG_TDO",
+		"IO_JTAG_TMS",
+		"",
+		"AP_SUSPEND_L",
+		"I2S_HP_MCK",
+		"I2S_HP_BCK",			/* 40 */
+		"I2S_HP_LRCK",
+		"I2S_HP_DI",
+		"I2S_HP_DO",
+		"",
+		"",
+		"",
+		"",
