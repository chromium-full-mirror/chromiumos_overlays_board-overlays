+#define DVFSRC_DEBUG_DUMP 0
+#define DVFSRC_DEBUG_AEE 1
+#define DVFSRC_DEBUG_VCORE_CHK 2
+
+#define DVFSRC_AEE_LEVEL_ERROR 0
+#define DVFSRC_AEE_FORCE_ERROR 1
