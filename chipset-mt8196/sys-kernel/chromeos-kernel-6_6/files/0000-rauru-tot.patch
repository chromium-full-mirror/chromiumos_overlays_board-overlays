diff --git a/drivers/misc/dvfsrc/dvfsrc-common.h b/drivers/misc/dvfsrc/dvfsrc-common.h
new file mode 100644
index 0000000000000000000000000000000000000000..0d2fea847d4a9473e026b3580da480ff8136bd37
--- /dev/null
+++ b/drivers/misc/dvfsrc/dvfsrc-common.h
@@ -0,0 +1,59 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Copyright (c) 2019 MediaTek Inc.
+ */
+#ifndef __DVFSRC_COMMON_H
+#define __DVFSRC_COMMON_H
+
+/* DEBUG INFO */
+#define DVFSRC_MD_RISING_DDR_REQ    0
+#define DVFSRC_MD_HRT_BW            1
+#define DVFSRC_HIFI_VCORE_REQ       2
+#define DVFSRC_HIFI_DDR_REQ         3
+#define DVFSRC_HIFI_RISING_DDR_REQ  4
