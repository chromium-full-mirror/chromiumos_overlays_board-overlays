+static void mtk_dp_mst_drv_configure_stream(struct mtk_dp *mtk_dp, int encoder_id)
+{
+	mtk_dp_mst_drv_stream_enable(mtk_dp, encoder_id);
+
+	mtk_dp_mst_drv_update_vcp_table(mtk_dp, encoder_id);
+}
