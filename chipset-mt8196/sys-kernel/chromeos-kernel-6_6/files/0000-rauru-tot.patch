+#define HWREQ_RES_NAME		(8)
+#define LPM_HWREQ_NAME	"hwreq"
+#define LPM_HWCG_NAME	"hw_cg"
+#define LPM_PERI_NAME	"peri_req"
+
+#define lpm_hwreq_log(buf, sz, len, fmt, args...) ({\
+	if (len < sz)\
+		len += scnprintf(buf + len, sz - len,\
+				 fmt, ##args); })
