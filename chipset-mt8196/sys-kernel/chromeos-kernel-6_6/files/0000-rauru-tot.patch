+	_n.type = _type;\
+	_n.rc_id = _id;\
+	LPM_CONSTRAINT_GENERIC_OP(_n.op, &_n); })
+
+/* this string array must be the same as TF-A common code */
+static char *pll_str[] = {
+	"UNIVPLL",
+	"UNIVPLL2",
+	"MFGPLL",
+	"MFGSCPLL",
+	"SENSONPLL",
+	"MSDCPLL",
+	"UFSPLL",
+	"TVDPLL",
+	"MMPLL",
+	"MMPLL2",
+	"MAINPLL2",
+	"IMGPLL",
+	"USBPLL",
+	"ADSPPLL",
+	"APLL1",
+	"APLL2",
+};
