+static void mtk_dpi_config_disable_edge_v2(struct mtk_dpi *dpi)
+{
+	if (dpi->conf->edge_sel_en)
+		mtk_dpi_mask_v2(dpi, dpi->conf->reg_h_fre_con, 0, EDGE_SEL_EN);
