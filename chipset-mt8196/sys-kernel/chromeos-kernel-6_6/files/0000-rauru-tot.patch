@@ -97,6 +97,16 @@ static inline u32 cmdq_reg_revert_addr(u32 addr, const struct gce_plat *pdata)
 	return ((addr << pdata->shift) - pdata->mminfra_offset);
 }
 
+/* TODO: this API should be implemented by mminfra driver */
+static void cmdq_mminfra_sel_enable(struct cmdq *cmdq, bool enable)
+{
+	/* enable mminfra_ao_gce_sel for GCE IRQ,*/
+	void *reg = ioremap(0x30080000, 0x1000) + 0x418;
+	u32 mask = BIT(0), value = enable ? BIT(0) : 0;
+
+	writel((readl(reg) & ~mask) | (value & mask), reg);
+}
+
 static void cmdq_sw_ddr_enable(struct cmdq *cmdq, bool enable)
 {
 	WARN_ON(clk_bulk_enable(cmdq->pdata->gce_num, cmdq->clocks));
@@ -183,6 +193,9 @@ static void cmdq_init(struct cmdq *cmdq)
 		writel(GCE_VM_MAP3_ALL_HOST, cmdq->base + GCE_VM_ID_MAP3);
 	}
 
+	if (cmdq->pdata->mminfra_offset)
+		cmdq_mminfra_sel_enable(cmdq, true);
+
 	if (cmdq->pdata->control_by_sw)
 		gctl_regval = GCE_CTRL_BY_SW;
 	if (cmdq->pdata->sw_ddr_en)
@@ -401,6 +414,9 @@ static int cmdq_suspend(struct device *dev)
 	if (cmdq->pdata->sw_ddr_en)
 		cmdq_sw_ddr_enable(cmdq, false);
 
+	if (cmdq->pdata->mminfra_offset)
+		cmdq_mminfra_sel_enable(cmdq, false);
+
 	return pm_runtime_force_suspend(dev);
 }
 
@@ -411,6 +427,9 @@ static int cmdq_resume(struct device *dev)
 	WARN_ON(pm_runtime_force_resume(dev));
 	cmdq->suspended = false;
 
+	if (cmdq->pdata->mminfra_offset)
+		cmdq_mminfra_sel_enable(cmdq, true);
+
 	if (cmdq->pdata->sw_ddr_en)
 		cmdq_sw_ddr_enable(cmdq, true);
 
@@ -427,6 +446,9 @@ static int cmdq_remove(struct platform_device *pdev)
 	if (!IS_ENABLED(CONFIG_PM))
 		cmdq_runtime_suspend(&pdev->dev);
 
+	if (cmdq->pdata->mminfra_offset)
+		cmdq_mminfra_sel_enable(cmdq, false);
+
 	clk_bulk_unprepare(cmdq->pdata->gce_num, cmdq->clocks);
 	return 0;
 }
