+{
+	struct mtk_dp_con *mtk_con = container_of(connector, struct mtk_dp_con, connector);
+
+	dev_dbg(mtk_con->mtk_dp->dev, "[%d]\n", mtk_dp_con_id(mtk_con->mtk_dp, mtk_con));
