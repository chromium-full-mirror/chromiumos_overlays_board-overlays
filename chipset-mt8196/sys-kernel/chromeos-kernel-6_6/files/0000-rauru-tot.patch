+
+	help->wakesrc->src_req = plat_mmio_read(SPM_SRC_REQ);
+
+	/* backup of SPM_WAKEUP_MISC */
+	help->wakesrc->wake_misc = plat_mmio_read(SPM_BK_WAKE_MISC);
+
+	/* get sleep time */
