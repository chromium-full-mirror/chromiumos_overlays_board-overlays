index 0000000000000000000000000000000000000000..73673ab0cd9c76696783820ec254f98d2ab7f8ba
--- /dev/null
+++ b/arch/arm64/boot/dts/mediatek/mt8196-rauru-navi.dtsi
@@ -0,0 +1,422 @@
+// SPDX-License-Identifier: (GPL-2.0 OR MIT)
+/*
+ * Copyright 2024 Google LLC
+ */
+
+/dts-v1/;
+#include "mt8196-rauru.dtsi"
+#include <dt-bindings/thermal/thermal.h>
+
+/ {
+	pp3300_edp_x: regulator-pp3300-edp-x {
+		compatible = "regulator-fixed";
+		regulator-name = "pp3300_edp_x";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		enable-active-high;
+		gpio = <&pio 172 GPIO_ACTIVE_HIGH>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&pp3300_edp_pin>;
+		vin-supply = <&pp3300_z1>;
+	};
+
+	pp1000_dpbrdg: regulator-pp1000-dpbrdg {
+		compatible = "regulator-fixed";
+		regulator-name = "pp1000_dpbrdg";
+		pinctrl-names = "default";
+		pinctrl-0 = <&pp1000_dpbrdg_pin>;
+		enable-active-high;
+		regulator-boot-on;
+		gpio = <&pio 82 GPIO_ACTIVE_HIGH>;
+		vin-supply = <&pp3300_z1>;
+	};
+
+	pp1800_dpbrdg: regulator-pp1800-dpbrdg-dx {
+		compatible = "regulator-fixed";
+		regulator-name = "pp1800_dpbrdg_dx";
+		pinctrl-names = "default";
+		pinctrl-0 = <&pp1800_dpbrdg_pin>;
+		enable-active-high;
+		regulator-boot-on;
+		gpio = <&pio 84 GPIO_ACTIVE_HIGH>;
+		vin-supply = <&mt6363_vio18>;
+	};
+
+	pp3300_dpbrdg: regulator-pp3300-dp-dx {
+		compatible = "regulator-fixed";
+		regulator-name = "pp3300_dpbrdg";
+		pinctrl-names = "default";
+		pinctrl-0 = <&pp3300_dpbrdg_pin>;
+		enable-active-high;
+		regulator-boot-on;
+		gpio = <&pio 83 GPIO_ACTIVE_HIGH>;
+		vin-supply = <&pp3300_z1>;
+	};
+};
+
+&cros_ec {
+	#thermal-sensor-cells = <1>;
+	#cooling-cells = <2>;
+
+	keyboard-backlight {
+		compatible = "google,cros-kbd-led-backlight";
+	};
+};
+
+&i2c3 {
+	quad_tas2563: audio-codec@4d {
+		compatible = "ti,tas2563";
+		reg = <0x4d>, /* Woffer Left */
+			<0x4f>,	/* Tweeter Left */
+			<0x4c>, /* Woffer Right */
+			<0x4e>; /* Tweeter Right */
+
+		#sound-dai-cells = <0>;
+		reset-gpios = <&pio 174 GPIO_ACTIVE_HIGH>;
+		interrupts-extended = <&pio 9 IRQ_TYPE_LEVEL_LOW>;
+		status = "okay";
+	};
+
+	rt5682s: audio-codec@1a {
+		compatible = "realtek,rt5682s";
+		reg = <0x1a>;
+		interrupt-parent = <&pio>;
+		interrupts = <10 IRQ_TYPE_EDGE_BOTH>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&nau8825_pins>;
+		realtek,jd-src = <1>;
+		#sound-dai-cells = <0>;
+		status = "okay";
+	};
+};
+
+&i2c4 {
+	anx_bridge: anx7625@58 {
+		compatible = "analogix,anx7625";
+		reg = <0x58>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&anx7625_pins>;
+		enable-gpios = <&pio 81 GPIO_ACTIVE_HIGH>;
+		reset-gpios = <&pio 86 GPIO_ACTIVE_HIGH>;
+		interrupts-extended = <&pio 14 IRQ_TYPE_LEVEL_LOW>;
+		vdd10-supply = <&pp1000_dpbrdg>;
+		vdd18-supply = <&pp1800_dpbrdg>;
+		vdd33-supply = <&pp3300_dpbrdg>;
+		analogix,audio-enable;
+		#address-cells = <1>;
+		#size-cells = <0>;
+		#sound-dai-cells = <0>;
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			port@0 {
+				reg = <0>;
+				anx7625_dp_in: endpoint {
+					remote-endpoint = <&dsi_out>;
+				};
+			};
+		};
+
+		switches {
+			#address-cells = <1>;
+			#size-cells = <0>;
+			switch@0 {
+				compatible = "typec-switch";
+				reg = <0>;
+				mode-switch;
+
+				ports {
+					#address-cells = <1>;
+					#size-cells = <0>;
+					port@0 {
+						reg = <0>;
+						anx_typec0: endpoint {
+							remote-endpoint = <&typec_port0>;
+						};
+					};
+				};
+			};
+		};
+	};
+};
+
+&dsi0 {
+	status = "okay";
+
+	port {
+		dsi_out: endpoint {
+			remote-endpoint = <&anx7625_dp_in>;
+		};
+	};
+};
+
+&usb_c0 {
+	ports {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		port@1 {
+			reg = <1>;
+
+			typec_port0: endpoint {
+				remote-endpoint = <&anx_typec0>;
+			};
+		};
+	};
+};
+
+&i2c2 {
+	/delete-node/ touchscreen@41;
+
+	/* goodix touchscreen */
+	touchscreen@14 {
+		compatible = "goodix,gt7986u", "goodix,gt7375p";
+		reg = <0x14>;
+		interrupts-extended = <&pio 7 IRQ_TYPE_LEVEL_LOW>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&touchscreen_pins>;
+		reset-gpios = <&pio 31 GPIO_ACTIVE_LOW>;
+		vdd-supply = <&mt6373_vtp>;
+	};
+};
+
+&i2c0 {
+	/* synaptics trackpad */
+	trackpad@2c  {
+		compatible = "hid-over-i2c";
+		reg = <0x2c>;
+		interrupts-extended = <&pio 8 IRQ_TYPE_LEVEL_LOW>;
+		hid-descr-addr = <0x20>;
+		vcc-supply = <&mt6373_vcn33_2>;
+		wakeup-source;
+	};
+
+	/* focal trackpad */
+	trackpad@38  {
+		compatible = "hid-over-i2c";
+		reg = <0x38>;
+		interrupts-extended = <&pio 8 IRQ_TYPE_LEVEL_LOW>;
+		hid-descr-addr = <0x0020>;
+		vcc-supply = <&mt6373_vcn33_2>;
+		wakeup-source;
+	};
+};
+
+&backlight {
+	status = "disabled";
+};
+
+&panel {
+	compatible = "samsung,atna33xc20";
+	enable-gpios = <&pio 216 GPIO_ACTIVE_HIGH>;
+	power-supply = <&pp3300_edp_x>;
+	/delete-property/ backlight;
+};
+
+&mt6373_vcn33_3 {
+	status = "disabled";
+};
+
+&afe {
+	/* Only for ETDM in/out 4 */
+	etdm-out-ch = <2>;
+	etdm-in-ch = <2>;
+	etdm-out-sync = <0>; /* 0: disable; 1: enable */
+	etdm-in-sync = <0>; /* 0: disable; 1: enable */
+	etdm-ip-mode = <0>; /* 0: One IP multi-channel 1: Multi-IP 2-channel */
+	status = "okay";
+};
+
+&sound {
+	compatible = "mediatek,mt8196-rt5682s-sound";
+	model = "mt8196_tas2563_5682";
+	mediatek,adsp = <&adsp>;
+	/*
+	 * TODO: Remove deprecated mediatek,dai-link, use audio-routing and
+	 * update UCM config.
+	 **/
+	mediatek,dai-link = "AFE_SOF_DL_24CH", "AFE_SOF_DL1", "AFE_SOF_UL0",
+			"AFE_SOF_UL1", "AFE_SOF_UL2", "HDMI_FE", "DL2_FE", "I2SIN6_BE",
+			"I2SOUT4_BE", "I2SOUT6_BE", "AP_DMIC_BE", "AP_DMIC_CH34_BE",
+			"TDM_DPTX_BE", "I2SOUT3_BE";
+	status = "okay";
+
+	dai-link-0 {
+		link-name = "I2SOUT6_BE";
+		mediatek,clk-provider = "cpu";
+
+		codec {
+			sound-dai = <&rt5682s>;
+		};
+	};
+
+	dai-link-1 {
+		link-name = "I2SIN6_BE";
+		mediatek,clk-provider = "cpu";
+
+		codec {
+			sound-dai = <&rt5682s>;
+		};
+	};
+
+	dai-link-2 {
+		link-name = "I2SOUT4_BE";
+		mediatek,clk-provider = "cpu";
+
+		codec {
+			sound-dai = <&quad_tas2563>;
+		};
+	};
+
+	dai-link-3 {
+		link-name = "TDM_DPTX_BE";
+
+		codec {
+			sound-dai = <&dp_tx>;
+		};
+	};
+
+	dai-link-4 {
+		link-name = "I2SOUT3_BE";
+		mediatek,clk-provider = "cpu";
+
+		codec {
+			sound-dai = <&anx_bridge>;
+		};
+	};
+};
+
+&thermal_zones {
+	bulk-board-thermal {
+		polling-delay = <1000>;
+		polling-delay-passive = <1000>;
+		thermal-sensors = <&cros_ec 0>;
+		sustainable-power = <3350>; /* estimated sustainable power when saturated */
+
+		trips {
+			bulk_threshold: trip-point@0 {
+				temperature = <45000>; /* switch on temperature */
+				hysteresis = <2000>;
+				type = "passive";
+			};
+			bulk_target: trip-point@1 {
+				temperature = <50000>; /* desired temperature */
+				hysteresis = <2000>;
+				type = "passive";
+			};
+		};
+
+		cooling-maps {
+			map0 {
+				trip = <&bulk_target>;
+				cooling-device =
+					<&cpu0 THERMAL_NO_LIMIT 10>,
+					<&cpu1 THERMAL_NO_LIMIT 10>,
+					<&cpu2 THERMAL_NO_LIMIT 10>,
+					<&cpu3 THERMAL_NO_LIMIT 10>;
+				contribution = <2048>;
+			};
+			map1 {
+				trip = <&bulk_target>;
+				cooling-device =
+					<&cpu4 THERMAL_NO_LIMIT 16>,
+					<&cpu5 THERMAL_NO_LIMIT 16>,
+					<&cpu6 THERMAL_NO_LIMIT 16>;
+				contribution = <1024>;
+			};
+			map2 {
+				trip = <&bulk_target>;
+				cooling-device =
+					<&cpu7 THERMAL_NO_LIMIT 19>;
+				contribution = <768>;
+			};
+		};
+	};
+};
+
+&keyboard_controller {
+	keypad,num-columns = <18>;
+
+	function-row-physmap = <
+		MATRIX_KEY(0x00, 0x02, 0)		/* T1 */
+		MATRIX_KEY(0x03, 0x02, 0)		/* T2 */
+		MATRIX_KEY(0x02, 0x02, 0)		/* T3 */
+		MATRIX_KEY(0x01, 0x02, 0)		/* T4 */
+		MATRIX_KEY(0x04, 0x04, 0)		/* T5 */
+		MATRIX_KEY(0x02, 0x04, 0)		/* T6 */
+		MATRIX_KEY(0x01, 0x04, 0)		/* T7 */
+		MATRIX_KEY(0x02, 0x0b, 0)		/* T8 */
+		MATRIX_KEY(0x01, 0x09, 0)		/* T9 */
+		MATRIX_KEY(0x00, 0x04, 0)		/* T10 */
+		MATRIX_KEY(0x00, 0x01, 0)		/* T11 */
+		MATRIX_KEY(0x01, 0x05, 0)		/* T12 */
+		MATRIX_KEY(0x03, 0x05, 0)		/* T13 */
+		MATRIX_KEY(0x00, 0x0b, 0)		/* T14 */
+	>;
+
+	linux,keymap = <
+		CROS_TOP_ROW_KEYMAP_V30
+		CROS_MAIN_KEYMAP_V30
+
+		MATRIX_KEY(0x00, 0x02, KEY_BACK)		/* T1 */
+		MATRIX_KEY(0x03, 0x02, KEY_REFRESH)		/* T2 */
+		MATRIX_KEY(0x02, 0x02, KEY_ZOOM)		/* T3 */
+		MATRIX_KEY(0x01, 0x02, KEY_SCALE)		/* T4 */
+		MATRIX_KEY(0x04, 0x04, KEY_SYSRQ)		/* T5 */
+		MATRIX_KEY(0x02, 0x04, KEY_BRIGHTNESSDOWN)	/* T6 */
+		MATRIX_KEY(0x01, 0x04, KEY_BRIGHTNESSUP)	/* T7 */
+		MATRIX_KEY(0x02, 0x0b, KEY_KBDILLUMTOGGLE)	/* T8 */
+		MATRIX_KEY(0x01, 0x09, KEY_MICMUTE)		/* T9 */
+		MATRIX_KEY(0x00, 0x04, KEY_MUTE)		/* T10 */
+		MATRIX_KEY(0x00, 0x01, KEY_VOLUMEDOWN)		/* T11 */
+		MATRIX_KEY(0x01, 0x05, KEY_VOLUMEUP)		/* T12 */
+		MATRIX_KEY(0x03, 0x05, KEY_ACCESSIBILITY)	/* T13 */
+		MATRIX_KEY(0x00, 0x0b, KEY_DICTATE)		/* T14 */
+	>;
+};
+
+&pio {
+	anx7625_pins: anx7625-pins {
+		pins-bus {
+			pinmux = <PINMUX_GPIO81__FUNC_GPIO81>,
+				 <PINMUX_GPIO86__FUNC_GPIO86>;
+			output-low;
+		};
+
+		pins-in {
+			pinmux = <PINMUX_GPIO14__FUNC_GPIO14>;
+			input-enable;
+			bias-pull-up;
+		};
+	};
+
+	pp3300_edp_pin: pp3300-edp-pins {
+		pins-en {
+			pinmux = <PINMUX_GPIO172__FUNC_GPIO172>;
+			output-high;
+		};
+	};
+
+	pp1000_dpbrdg_pin: pp1000-dpbrdg-pins {
+		pins-en {
+			pinmux = <PINMUX_GPIO82__FUNC_GPIO82>;
+			output-low;
+		};
+	};
+
+	pp1800_dpbrdg_pin: pp1800-dpbrdg-pins {
+		pins-en {
+			pinmux = <PINMUX_GPIO84__FUNC_GPIO84>;
+			output-low;
+		};
+	};
+
+	pp3300_dpbrdg_pin: en-pp3300-dpbrdg-pins {
+		pins-en {
+			pinmux = <PINMUX_GPIO83__FUNC_GPIO83>;
+			output-low;
+		};
+	};
+};
diff --git a/arch/arm64/boot/dts/mediatek/mt8196-rauru-rev0.dts b/arch/arm64/boot/dts/mediatek/mt8196-rauru-rev0.dts
new file mode 100644
index 0000000000000000000000000000000000000000..2535e51348d4157356257e3bf614587257e659c3
--- /dev/null
+++ b/arch/arm64/boot/dts/mediatek/mt8196-rauru-rev0.dts
@@ -0,0 +1,108 @@
+// SPDX-License-Identifier: (GPL-2.0 OR MIT)
+/*
+ * Copyright 2024 Google LLC
+ */
+
+/dts-v1/;
+#include "mt8196-rauru.dtsi"
+
+/ {
+	model = "Google Rauru board";
+	compatible = "google,rauru", "mediatek,mt8196";
+};
+
+&nau8318 {
+	status = "okay";
+};
+
+&nau8825 {
+	status = "okay";
+};
+
+&afe {
+	/* Only for ETDM in/out 4 */
+	etdm-out-ch = <2>;
+	etdm-in-ch = <2>;
+	etdm-out-sync = <0>; /* 0: disable; 1: enable */
+	etdm-in-sync = <0>; /* 0: disable; 1: enable */
+	etdm-ip-mode = <0>; /* 0: One IP multi-channel 1: Multi-IP 2-channel */
+	status = "okay";
+};
+
+&sound {
+	compatible = "mediatek,mt8196-nau8825-sound";
+	model = "mt8196_nau8318_8825";
+	mediatek,adsp = <&adsp>;
+	/*
+	 * TODO: Remove deprecated mediatek,dai-link, use audio-routing and
+	 * update UCM config.
+	 **/
+	mediatek,dai-link = "AFE_SOF_DL_24CH", "AFE_SOF_DL1", "AFE_SOF_UL0",
+			"AFE_SOF_UL1", "AFE_SOF_UL2", "HDMI_FE", "I2SIN6_BE",
+			"I2SOUT4_BE", "I2SOUT6_BE", "AP_DMIC_BE", "AP_DMIC_CH34_BE",
+			"TDM_DPTX_BE";
+	status = "okay";
+
+	dai-link-0 {
+		link-name = "I2SOUT6_BE";
+		mediatek,clk-provider = "cpu";
+
+		codec {
+			sound-dai = <&nau8825>;
+		};
+	};
+
+	dai-link-1 {
+		link-name = "I2SIN6_BE";
+		mediatek,clk-provider = "cpu";
+
+		codec {
+			sound-dai = <&nau8825>;
+		};
+	};
+
+	dai-link-2 {
+		link-name = "I2SOUT4_BE";
+		mediatek,clk-provider = "cpu";
+
+		codec {
+			sound-dai = <&nau8318>;
+		};
+	};
+
+	dai-link-3 {
+		link-name = "TDM_DPTX_BE";
+		codec {
+			sound-dai = <&dp_tx>;
+		};
+	};
+};
+
+&keyboard_controller {
+	function-row-physmap = <
+		MATRIX_KEY(0x00, 0x02, 0)	/* T1 */
+		MATRIX_KEY(0x03, 0x02, 0)	/* T2 */
+		MATRIX_KEY(0x02, 0x02, 0)	/* T3 */
+		MATRIX_KEY(0x01, 0x02, 0)	/* T4 */
+		MATRIX_KEY(0x03, 0x04, 0)	/* T5 */
+		MATRIX_KEY(0x02, 0x04, 0)	/* T6 */
+		MATRIX_KEY(0x01, 0x04, 0)	/* T7 */
+		MATRIX_KEY(0x02, 0x09, 0)	/* T8 */
+		MATRIX_KEY(0x01, 0x09, 0)	/* T9 */
+		MATRIX_KEY(0x00, 0x04, 0)	/* T10 */
+	>;
+
+	linux,keymap = <
+		MATRIX_KEY(0x00, 0x02, KEY_BACK)
+		MATRIX_KEY(0x03, 0x02, KEY_REFRESH)
+		MATRIX_KEY(0x02, 0x02, KEY_ZOOM)
+		MATRIX_KEY(0x01, 0x02, KEY_SCALE)
+		MATRIX_KEY(0x03, 0x04, KEY_SYSRQ)
+		MATRIX_KEY(0x02, 0x04, KEY_BRIGHTNESSDOWN)
+		MATRIX_KEY(0x01, 0x04, KEY_BRIGHTNESSUP)
+		MATRIX_KEY(0x02, 0x09, KEY_MUTE)
+		MATRIX_KEY(0x01, 0x09, KEY_VOLUMEDOWN)
+		MATRIX_KEY(0x00, 0x04, KEY_VOLUMEUP)
+		CROS_STD_MAIN_KEYMAP
+	>;
+};
diff --git a/arch/arm64/boot/dts/mediatek/mt8196-rauru.dtsi b/arch/arm64/boot/dts/mediatek/mt8196-rauru.dtsi
new file mode 100644
index 0000000000000000000000000000000000000000..89afe5533986f587536529eee0d67b16bedbe26d
--- /dev/null
+++ b/arch/arm64/boot/dts/mediatek/mt8196-rauru.dtsi
@@ -0,0 +1,1375 @@
+// SPDX-License-Identifier: (GPL-2.0 OR MIT)
+/*
+ * Copyright (C) 2024 Google Inc.
+ */
+/dts-v1/;
+#include "mt8196.dtsi"
+#include "mt6316.dtsi"
+#include "mt6363.dtsi"
+#include "mt6373.dtsi"
+#include "mt6685.dtsi"
+#include <dt-bindings/pinctrl/mt8196-pinfunc.h>
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/input/gpio-keys.h>
+
+/ {
+	chosen: chosen {
+		stdout-path = "serial0:115200n8";
+	};
+
+	backlight: backlight {
+		compatible = "pwm-backlight";
+		pinctrl-names = "default";
+		pinctrl-0 = <&backlight_en_pin>;
+		pwms = <&disp_pwm0 0 500000>;
+		power-supply = <&ppvar_edp_bl_s3>;
+		enable-gpios = <&pio 216 GPIO_ACTIVE_HIGH>;
+		brightness-levels = <0 1023>;
+		num-interpolated-steps = <1023>;
+		default-brightness-level = <576>;
+	};
+
+	dmic-codec {
+		compatible = "dmic-codec";
+		num-channels = <2>;
+		wakeup-delay-ms = <50>;
+	};
+
+	/* system wide LDO 3.3V power rail */
+	pp3300_ldo_z5: regulator-pp3300-ldo-z5 {
+		compatible = "regulator-fixed";
+		regulator-name = "pp3300_ldo_z5";
+		regulator-always-on;
+		regulator-boot-on;
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		vin-supply = <&ppvar_sys>;
+	};
+
+	/* system wide LDO 5.0V power rail */
+	pp5000_ldo_z5: regulator-pp5000-ldo-z5 {
+		compatible = "regulator-fixed";
+		regulator-name = "pp5000_ldo_z5";
+		regulator-always-on;
+		regulator-boot-on;
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		vin-supply = <&ppvar_sys>;
+	};
+
+	/* separately switched 3.3V power rail */
+	pp3300_ssd_s3: regulator-pp3300-ssd-s3 {
+		compatible = "regulator-fixed";
+		regulator-name = "pp3300_ssd_s3";
+		/* automatically sequenced by PMIC EXT_PMIC_EN2_3V7 */
+		regulator-always-on;
+		regulator-boot-on;
+		vin-supply = <&pp3300_z1>;
+	};
+
+	/* separately switched 3.3V power rail */
+	pp3300_wlan_s3: regulator-pp3300-wlan-s3 {
+		compatible = "regulator-fixed";
+		regulator-name = "pp3300_wlan_s3";
+		/* automatically sequenced by PMIC EXT_PMIC_EN2_3V7 */
+		regulator-always-on;
+		regulator-boot-on;
+		vin-supply = <&pp3300_z1>;
+	};
+
+	/* separately switched 3.3V power rail */
+	pp3300_fp: regulator-pp3300-fp {
+		compatible = "regulator-fixed";
+		regulator-name = "pp3300_fp";
+		regulator-always-on;
+		regulator-boot-on;
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&fp_pwr_pin>;
+		vin-supply = <&pp3300_z1>;
+	};
+
+	/* separately switched 3.3V power rail */
+	pp3300_hdmi: regulator-pp3300-hdmi {
+		compatible = "regulator-fixed";
+		regulator-name = "pp3300_hdmi";
+		/* EN_HDMI_PWR controlled by EC */
+		regulator-always-on;
+		regulator-boot-on;
+		vin-supply = <&pp3300_z1>;
+	};
+
+	/* system wide 3.3V power rail */
+	pp3300_z1: regulator-pp3300-z1 {
+		compatible = "regulator-fixed";
+		regulator-name = "pp3300_z1";
+		/* controlled by EC */
+		regulator-always-on;
+		regulator-boot-on;
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		vin-supply = <&ppvar_sys>;
+	};
+
+	/* system wide 3.7V power rail */
+	pp3700_s5: regulator-pp3700-s5 {
+		compatible = "regulator-fixed";
+		regulator-name = "pp3700_s5";
+		/* EN_PP3700_S5 controlled by EC */
+		regulator-always-on;
+		regulator-boot-on;
+		regulator-min-microvolt = <3700000>;
+		regulator-max-microvolt = <3700000>;
+		vin-supply = <&ppvar_sys>;
+	};
+
+	/* system wide 5.0V power rail */
+	pp5000_z1: regulator-pp5000-z1 {
+		compatible = "regulator-fixed";
+		regulator-name = "pp5000_z1";
+		/* EN_PP5000_Z1 controlled by EC */
+		regulator-always-on;
+		regulator-boot-on;
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		vin-supply = <&ppvar_sys>;
+	};
+
+	/* separately switched 5.0V power rail */
+	pp5000_hdmi: regulator-pp5000-hdmi {
+		compatible = "regulator-fixed";
+		regulator-name = "pp5000_hdmi";
+		/* EN_HDMI_PWR controlled by EC */
+		regulator-always-on;
+		regulator-boot-on;
+		vin-supply = <&pp5000_z1>;
+	};
+
+	/* separately switched 5.0V power rail */
+	pp5000_usb: regulator-pp5000-usb {
+		compatible = "regulator-fixed";
+		regulator-name = "pp5000_usb";
+		regulator-always-on;
+		regulator-boot-on;
+		enable-active-high;
+		gpio = <&pio 28 GPIO_ACTIVE_HIGH>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&usb_init_done_pins>;
+		vin-supply = <&pp5000_z1>;
+	};
+
+	/* system wide semi-regulated power rail from battery or USB */
+	ppvar_edp_bl_s3:
+	ppvar_sys: regulator-ppvar-sys {
+		compatible = "regulator-fixed";
+		regulator-name = "ppvar_sys";
+		regulator-always-on;
+		regulator-boot-on;
+	};
+
+	nau8318: speaker-codec {
+		compatible = "nuvoton,nau8318";
+		enable-gpios = <&pio 174 0>;/* EN_SPKR */
+		beep-enable-gpios = <&pio 175 0>;/* BEEP_ON */
+		#sound-dai-cells = <0>;
+
+		status = "disabled";
+	};
+
+	mtk_fsource: fsource {
+		compatible = "mtk-fsource";
+		vfsource-supply = <&mt6373_vefuse>;
+	};
+
+};
+
+&adsp {
+	memory-region = <&adsp_dma_mem_reserved>,
+			<&adsp_mem_reserved>;
+	pinctrl-names = "default";
+	status = "okay";
+};
+
+&afe {
+	memory-region = <&afe_dma_mem_reserved>;
+	status = "disabled";
+};
+
+&cpu0 {
+	proc-supply = <&mt6316_8_vbuck3>;
+};
+
+&cpu1 {
+	proc-supply = <&mt6316_8_vbuck3>;
+};
+
+&cpu2 {
+	proc-supply = <&mt6316_8_vbuck3>;
+};
+
+&cpu3 {
+	proc-supply = <&mt6316_8_vbuck3>;
+};
+
+&cpu4 {
+	proc-supply = <&mt6316_6_vbuck1>;
+};
+
+&cpu5 {
+	proc-supply = <&mt6316_6_vbuck1>;
+};
+
+&cpu6 {
+	proc-supply = <&mt6316_6_vbuck1>;
+};
+
+&cpu7 {
+	proc-supply = <&mt6316_15_vbuck1>;
+};
+
+&disp_dvo0 {
+	status = "okay";
+
+	ports {
+		port {
+			disp_dvo0_out: endpoint {
+				remote-endpoint = <&edp_in>;
+			};
+		};
+	};
+};
+
+&disp_pwm0 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pwm_pin>;
+
+	status = "okay";
+};
+
+&dp_intf0 {
+	status = "okay";
+
+	ports {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		port@0 {
+			reg = <0>;
+			disp1_dp_intf0_out: endpoint {
+				remote-endpoint = <&dptx_in0>;
+			};
+		};
+	};
+};
+
+&dp_intf1 {
+	status = "okay";
+
+	ports {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		port@0 {
+			reg = <0>;
+			disp1_dp_intf1_out: endpoint {
+				remote-endpoint = <&dptx_in1>;
+			};
+		};
+	};
+};
+
+&dp_tx {
+	#sound-dai-cells = <0>;
+	pinctrl-names = "default";
+	pinctrl-0 = <&dp_hpd_pin>;
+	direct-dp;
+
+	status = "okay";
+
+	ports {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		port@0 {
+			reg = <0>;
+			dptx_in0: endpoint {
+				remote-endpoint = <&disp1_dp_intf0_out>;
+			};
+		};
+
+		port@1 {
+			reg = <1>;
+			dptx_in1: endpoint {
+				remote-endpoint = <&disp1_dp_intf1_out>;
+			};
+		};
+
+		port@2 {
+			reg = <2>;
+			dptx_out: endpoint {
+				data-lanes = <0 1 2 3>;
+			};
+		};
+	};
+};
+
+&edp_tx {
+	pinctrl-names = "default";
+	pinctrl-0 = <&edp_hpd_pin>;
+
+	status = "okay";
+
+	ports {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		port@0 {
+			reg = <0>;
+			edp_in: endpoint {
+				remote-endpoint = <&disp_dvo0_out>;
+			};
+		};
+
+		port@1 {
+			reg = <1>;
+			edp_out: endpoint {
+				data-lanes = <0 1 2 3>;
+				remote-endpoint = <&edp_panel_in>;
+			};
+		};
+	};
+
+	aux-bus {
+		panel: panel {
+			compatible = "edp-panel";
+			power-supply = <&mt6373_vcn33_3>;
+			backlight = <&backlight>;
+
+			status = "okay";
+
+			port {
+				edp_panel_in: endpoint {
+					remote-endpoint = <&edp_out>;
+				};
+			};
+		};
+	};
+};
+
+&pcie0 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pcie0_pins>;
+	status = "okay";
+};
+
+&pcie1 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pcie1_pins>;
+	/* pcie1 for SSD is reserved but unused. */
+	status = "disabled";
+};
+
+&pciephy0 {
+	status = "okay";
+};
+
+&mt6373_vaux18 {
+	regulator-name = "avss18_auxadc_mt6373";
+	regulator-min-microvolt = <1800000>;
+	regulator-max-microvolt = <1800000>;
+};
+
+&mt6373_vefuse {
+	regulator-name = "pp1800_vefuse";
+	regulator-min-microvolt = <1800000>;
+	regulator-max-microvolt = <1800000>;
+};
+
+&mt6363_vio18 {
+	regulator-name = "pp1800_vio18_s3";
+	regulator-min-microvolt = <1800000>;
+	regulator-max-microvolt = <1800000>;
+};
+
+&mt6373_vmc {
+	regulator-name = "pp1800_2900_vmc";
+	regulator-min-microvolt = <1800000>;
+	regulator-max-microvolt = <2900000>;
+
+	status = "okay";
+};
+
+&mt6373_vmch_eint_high {
+	regulator-name = "pp2900_sd";
+	/* TODO: Confirm with HW */
+	regulator-min-microvolt = <1200000>;
+	regulator-max-microvolt = <2900000>;
+
+	status = "okay";
+};
+
+&mt6373_vsim1 {
+	regulator-name = "pp1800_tchscr";
+	regulator-min-microvolt = <1800000>;
+	regulator-max-microvolt = <1800000>;
+};
+
+&mt6373_vcn33_1 {
+	regulator-name = "pp3300_ucam";
+	regulator-min-microvolt = <3300000>;
+	regulator-max-microvolt = <3300000>;
+};
+
+&mt6373_vcn33_2 {
+	regulator-name = "pp3300_tchpad";
+	regulator-min-microvolt = <3300000>;
+	regulator-max-microvolt = <3300000>;
+
+	/* HACK: b/333996526 */
+	regulator-always-on;
+
+	status = "okay";
+};
+
+&mt6373_vcn33_3 {
+	regulator-name = "pp3300_edp";
+	regulator-min-microvolt = <3300000>;
