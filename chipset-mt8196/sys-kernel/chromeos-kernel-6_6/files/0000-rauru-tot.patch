+static void debug_dump(unsigned int id, unsigned int pwr_sta)
+{
+	int i, parent_id = PD_NULL;
+
+	if (id >= MT8196_CHK_PD_NUM)
+		return;
+
+	for (i = 0; i < ARRAY_SIZE(mtk_subsys_check); i++) {
+		if (mtk_subsys_check[i].pd_id == id) {
+			print_subsys_reg_mt8196(mtk_subsys_check[i].chk_id);
+			parent_id = mtk_subsys_check[i].pd_parent;
+			break;
+		}
+	}
+
+	for (i = 0; i < ARRAY_SIZE(mtk_subsys_check); i++) {
+		if (parent_id == PD_NULL)
+			break;
+
+		if (mtk_subsys_check[i].pd_id == parent_id)
+			print_subsys_reg_mt8196(mtk_subsys_check[i].chk_id);
+	}
+
+	if (pwr_sta)
+		clkchk_debug_dump_mt8196(debug_dump_id, "scpsys_hwv_on", pdchk_bug_on_flag, pdchk_bug_on_flag);
+	else
+		clkchk_debug_dump_mt8196(debug_dump_id, "scpsys_hwv_off", pdchk_bug_on_flag, pdchk_bug_on_flag);
+}
