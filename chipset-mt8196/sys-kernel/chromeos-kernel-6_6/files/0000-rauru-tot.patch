+#define MD_GUARD_NUMBER 0x536C702E
+#define GET_RECORD_CNT1(n) ((n >> 32) & 0xFFFFFFFF)
+#define GET_RECORD_CNT2(n) (n & 0xFFFFFFFF)
+#define GET_GUARD_L(n) (n & 0xFFFFFFFF)
+#define GET_GUARD_H(n) ((n >> 32) & 0xFFFFFFFF)
