+	u32 value = 0, id = 0;
+	struct device_node *np = NULL;
+
+	while ((np = of_parse_phandle(parent, LPM_RC_NODE, idx))) {
+		idx++;
+
+		of_property_read_u32(np, LPM_RC_ID, &id);
