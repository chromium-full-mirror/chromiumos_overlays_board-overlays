# Initial value just for style purposes.
LINUX_FIRMWARE=""
USE=""

# Add EC logging
USE="${USE} eclog"

# Tell powerd to use elogtool to log system events.
USE="${USE} powerd_manual_eventlog_add"

# Use opengles
USE="${USE} -opengl opengles"

# Enable for daisydog
USE="${USE} watchdog"

# Enable Chrome's tablet mode
USE="${USE} touchview"

# Use ext4 crypto
USE="${USE} direncryption"

# Declare TPM model.
USE="${USE} -tpm tpm2"
USE="${USE} cr50_onboard"

# Google USBPD peripheral firmwares
LINUX_FIRMWARE="${LINUX_FIRMWARE} cros-pd"

# MT7921E WiFi firmware
LINUX_FIRMWARE="${LINUX_FIRMWARE} mt7921e"

# MT7921E USB BT firmware
LINUX_FIRMWARE="${LINUX_FIRMWARE} mt7921e-bt"

# Enable eMMC tools
USE="${USE} mmc"

# Set mosys_platform
# TODO: replace with the commented line when Geralt is ready in mosys
# USE="${USE} -mosys_platform_generic mosys_platform_geralt"
USE="${USE} mosys_platform_generic"

# Hack: Use TPM2 simulator for early bring-up
USE="${USE} -tpm tpm2 tpm2_simulator tpm2_simulator_manufacturer vtpm_proxy -cr50_onboard"
