From: Roy Yang <royyang@google.com>
Date: Mon, 18 May 2020 09:51:38 -0700
Subject: [PATCH] Fix oslogin CVEs

---
 .../google-compute-engine-oslogin/bin/google_oslogin_control    | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/packages/google-compute-engine-oslogin/bin/google_oslogin_control b/packages/google-compute-engine-oslogin/bin/google_oslogin_control
index 75d43bf..06d39a5 100644
--- a/packages/google-compute-engine-oslogin/bin/google_oslogin_control
+++ b/packages/google-compute-engine-oslogin/bin/google_oslogin_control
@@ -223,7 +223,7 @@ restore_pam_sshd() {
 
 modify_group_conf() {
   local group_config="${1:-${group_config}}"
-  local group_conf_entry="sshd;*;*;Al0000-2400;adm,dip,docker,lxd,plugdev,video"
+  local group_conf_entry="sshd;*;*;Al0000-2400;video"
 
   if ! grep -q "$group_conf_entry" "$group_config"; then
     $sed -i"" "\$a ${added_comment}\n${group_conf_entry}" "$group_config"
