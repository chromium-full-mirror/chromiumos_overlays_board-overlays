# Initial value just for style purposes.
USE=""
LINUX_FIRMWARE=""

USE="${USE} cros_ec"
USE="${USE} trogdor"

# Enable biod
USE="${USE} biod"

# Use ext4 crypto
USE="${USE} direncryption"

# Enable QMI support in ModemManager
USE="${USE} qmi qrtr"

# Enable Firmware Build
USE="${USE} bootimage"

# Enable Cellular SAR hack on trogdor
USE="${USE} trogdor_sar_hack"

# All firmwares to build from the EC code base
EC_FIRMWARE="trogdor"

# Include the elan_i2chid firmware updating tool
INPUT_DEVICES="${INPUT_DEVICES} elan_i2chid"
